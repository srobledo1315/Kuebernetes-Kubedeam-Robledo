// Archivo gestionado por Ansible - NO EDITAR MANUALMENTE
options {
    listen-on port 53 { 127.0.0.1; {{ dns_server_ip }}; };
    listen-on-v6 port 53 { ::1; };
    directory       "/var/named";
    dump-file       "/var/named/data/cache_dump.db";
    statistics-file "/var/named/data/named_stats.txt";
    memstatistics-file "/var/named/data/named_mem_stats.txt";
    secroots-file   "/var/named/data/named.secroots";
    recursing-file  "/var/named/data/named.recursing";
    
    allow-query     { {% for acl in dns_allow_query %}{{ acl }}; {% endfor %} };
    
    recursion yes;
    
    {% if dns_forwarders is defined and dns_forwarders | length > 0 %}
    forwarders {
        {% for fw in dns_forwarders %}
        {{ fw }};
        {% endfor %}
    };
    forward only;
    {% endif %}

    dnssec-validation yes;
    managed-keys-directory "/var/named/dynamic";
    pid-file "/run/named/named.pid";
    session-keyfile "/run/named/session.key";
    
    include "/etc/crypto-policies/back-ends/bind.config";
};

logging {
        channel default_debug {
                file "data/named.run";
                severity dynamic;
        };
};

zone "." IN {
    type hint;
    file "named.ca";
};

zone "{{ dns_domain }}" IN {
    type master;
    file "{{ dns_domain }}.db";
    allow-update { none; };
};

zone "{{ dns_reverse_zone }}" IN {
    type master;
    file "{{ dns_reverse_zone }}.db";
    allow-update { none; };
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";
